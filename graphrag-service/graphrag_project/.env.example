# Copy to .env only in the offline indexing environment. Never commit real secrets.
GRAPHRAG_API_KEY=
GRAPHRAG_API_BASE=https://api.openai.com/v1
GRAPHRAG_MODEL_PROVIDER=openai
GRAPHRAG_COMPLETION_MODEL=gpt-4.1-mini
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small

# Full indexing sends the prepared 925-record public-safe corpus to the configured
# model provider and may incur cost. This exact acknowledgement is mandatory.
GRAPHRAG_EXTERNAL_INDEXING_APPROVED=I_UNDERSTAND_DATA_WILL_BE_SENT_TO_MODEL_PROVIDER

# Runtime retrieval must set these separately. Production refuses auto/bootstrap.
HUAMEI_ENVIRONMENT=production
HUAMEI_GRAPHRAG_ENGINE=official
HUAMEI_GRAPHRAG_INDEX_VERSION=
