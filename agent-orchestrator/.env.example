# Only accepted on the internal private network. Generate an independent
# secret; never reuse the LLM, GraphRAG or gateway service key.
HUAMEI_LANGGRAPH_SERVICE_AUTH_SECRET=replace_with_random_32_plus_char_secret
HUAMEI_LANGGRAPH_RUNTIME_ENV=development
HUAMEI_LANGGRAPH_SERVICE_NAME=huamei-agent-orchestrator
HUAMEI_LANGGRAPH_AUDIENCE=huamei-agent-orchestrator
# Required in production; use a dedicated least-privilege PostgreSQL role.
HUAMEI_LANGGRAPH_CHECKPOINT_DATABASE_URL=
# P0-A defaults to false. Do not enable until the checkpoint schema, tenant
# isolation, retention, migration/rollback and data-flow review are admitted.
HUAMEI_LANGGRAPH_ENABLE_DURABLE_CHECKPOINTS=false
HUAMEI_LANGGRAPH_MAX_MESSAGE_CHARS=2000
HUAMEI_LANGGRAPH_MAX_CONCURRENCY=20
