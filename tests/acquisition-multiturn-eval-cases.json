    { "id": "single_question", "label": "结尾问句不超过一个", "pattern": "[？?]", "mode": "max_count", "max": 1 },
    { "id": "bounded_length", "label": "回复长度不超过 300 字", "mode": "max_length", "max": 300 },
    { "id": "no_invite_stack", "label": "不堆叠模板化邀请", "pattern": "还有其他想了解的吗[\\s\\S]*预约", "mode": "forbid" }
  ],
