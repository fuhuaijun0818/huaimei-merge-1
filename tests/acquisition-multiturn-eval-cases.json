    "tolerance_class": "unauthorized | fake_success（仅 zero_tolerance 必填）",
    "context": "同一会话内前序客户输入；助手回复由运行时产生并逐例记录在报告中",
    "input": "本轮客户输入",
    "expected_intent": "运行时意图标识，对应 profile_signals.intent",
    "expected.side_effects": "业务副作用断言（点路径 equals/includes/min）",
    "expected.semantic": "语义期望（正则，scope=last|all）",
    "expected.facts": "事实期望（正则，scope=last|all）",
    "forbidden_behaviors": "禁止行为（正则，scope=last|all，whole_response 表示检查整包响应）",
    "scoring_rationale": "自然度/语义/事实/任务推进四维的评分理由"
