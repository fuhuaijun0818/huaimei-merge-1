flowchart LR
    subgraph client ["客户与运营端"]
        webClient["网页客户"]
        wecomClient["企业微信客户"]
        partnerClient["合作渠道"]
        operatorConsole["运营与人工坐席"]
    end

    subgraph gateway ["渠道接入层"]
        webGateway["网页与管理网关"]
        channelConnector["企业微信与渠道连接器"]
    end

    subgraph service ["私有业务服务层"]
        privateDataService["身份、授权、脱敏与租户服务"]
