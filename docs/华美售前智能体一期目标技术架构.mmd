        collaborationService["事件、任务与转人工服务"]
        integrationService["CRM与预约集成服务"]
        modelGateway["模型网关"]
    end

    subgraph datastore ["私有数据存储"]
        postgresStore["业务数据存储 (当前JSON适配器 / 目标PostgreSQL)"]
        redisStore["会话与幂等存储 (当前持久化 / 目标Redis)"]
        objectStore["知识证据与版本对象存储"]
    end

    subgraph async ["事件与任务总线"]
        eventBus["消息队列与Outbox (下一阶段)"]
    end

    subgraph external ["院方与外部系统"]
        hospitalSystems["华美CRM、排班与企业微信"]
