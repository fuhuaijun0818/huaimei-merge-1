# Copy this file to deploy/.env. Never commit deploy/.env.
# Domain with automatic HTTPS: demo.example.com
# Temporary HTTP-by-IP test: :80
PUBLIC_SITE_ADDRESS=
ADMIN_SITE_ADDRESS=
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# Caddy must not publish on 0.0.0.0/::. Use 127.0.0.1 when the approved
# OIDC/WAF proxy is on this host, otherwise its dedicated private interface.
HUAMEI_EDGE_BIND_ADDRESS=127.0.0.1

# Immutable release identity and images. Resolve registry tags to digests before
# editing this file; mutable tags such as latest or 1.0.0 are rejected.
HUAMEI_COMPOSE_PROJECT_NAME=huamei-production
HUAMEI_RELEASE_ID=
HUAMEI_ACTIVE_KNOWLEDGE_RELEASE_ID=
HUAMEI_APP_IMAGE=
HUAMEI_GRAPHRAG_IMAGE=
HUAMEI_POSTGRES_IMAGE=
HUAMEI_REDIS_IMAGE=
HUAMEI_CADDY_IMAGE=
HUAMEI_CANARY_TOKEN=
# Required only while deploy/docker-compose.canary.example.yml is included.
HUAMEI_CANARY_APP_IMAGE=
HUAMEI_CANARY_GRAPHRAG_IMAGE=

# Optional only for HUAMEI_EXTERNAL_TEST_MODE=true. Preview credentials can
# access the advisor/public API but can never authorize management routes.
HUAMEI_PREVIEW_USERNAME=
HUAMEI_PREVIEW_PASSWORD=

# Required API and identity secrets; use independent random values of at least 32 bytes.
HUAMEI_API_KEY=
HUAMEI_IDENTITY_PEPPER=
HUAMEI_PRIVACY_VERIFICATION_SECRET=
HUAMEI_PRIVACY_COMPLETION_SECRET=
HUAMEI_PRIVACY_CANCELLATION_SECRET=

# Browser origins allowed to call the API, comma-separated and without a trailing slash.
# Include both distinct customer and management origins.
# Example: https://advisor.example.com,https://admin.example.com
HUAMEI_ALLOWED_ORIGINS=
HUAMEI_API_RATE_LIMIT=60
HUAMEI_PUBLIC_WEB_RATE_LIMIT=20
HUAMEI_DEFAULT_TENANT_ID=huamei-shanghai
HUAMEI_PUBLIC_TENANT_ID=huamei-shanghai

# Production persistence and shared coordination. Use secrets supplied by the
# deployment platform; the placeholders below are deliberately non-functional.
HUAMEI_PERSISTENCE_BACKEND=postgres
HUAMEI_CACHE_BACKEND=redis
HUAMEI_POSTGRES_DB=huamei
HUAMEI_POSTGRES_BOOTSTRAP_USER=huamei_bootstrap
HUAMEI_POSTGRES_BOOTSTRAP_PASSWORD=
HUAMEI_BOOTSTRAP_DATABASE_URL=postgresql://huamei_bootstrap:replace_with_bootstrap_secret@postgres:5432/huamei
HUAMEI_POSTGRES_OWNER_ROLE=huamei_owner
HUAMEI_POSTGRES_MIGRATION_USER=huamei_migrator
HUAMEI_POSTGRES_MIGRATION_PASSWORD=
HUAMEI_MIGRATION_DATABASE_URL=postgresql://huamei_migrator:replace_with_migration_secret@postgres:5432/huamei
HUAMEI_POSTGRES_APP_USER=huamei_runtime
HUAMEI_POSTGRES_APP_PASSWORD=
HUAMEI_DATABASE_URL=postgresql://huamei_runtime:replace_with_runtime_secret@postgres:5432/huamei
HUAMEI_POSTGRES_POOL_MAX=40
HUAMEI_POSTGRES_IDLE_TIMEOUT_MS=30000
HUAMEI_POSTGRES_CONNECT_TIMEOUT_MS=5000
HUAMEI_POSTGRES_STATEMENT_TIMEOUT_MS=15000
HUAMEI_POSTGRES_QUERY_TIMEOUT_MS=20000
HUAMEI_POSTGRES_LOCK_TIMEOUT_MS=3000
HUAMEI_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
HUAMEI_REDIS_PASSWORD=
HUAMEI_REDIS_URL=redis://:replace_with_production_secret@redis:6379/0
HUAMEI_REDIS_CONNECT_TIMEOUT_MS=5000
HUAMEI_REDIS_COMMAND_TIMEOUT_MS=3000
HUAMEI_EXTERNAL_DEPENDENCY_READINESS_MAX_AGE_MS=20000
HUAMEI_EXTERNAL_DEPENDENCY_PROBE_TIMEOUT_MS=4000
HUAMEI_ACQUISITION_READY_TIMEOUT_MS=6000

# Required application-layer encryption keyring. Inject the complete JSON from
# the deployment secret manager. Never commit a real key. Generate each key
# with `openssl rand -base64 32`; retain old versions until re-encryption ends.
# Fresh-v2 schema: {"active_key_id":"phase1-v2","keys":{"phase1-v2":"<base64-32-byte-key>"}}
# Controlled v1→v2 cutover temporarily retains both independent keys; see FIELD_ENCRYPTION.md.
HUAMEI_FIELD_ENCRYPTION_KEYRING_JSON=
# Dedicated KMS/secret domain for reversible customer contact data. Generate a
# different 32-byte key; reuse of any general field-encryption key is rejected.
HUAMEI_CONTACT_VAULT_KEYRING_JSON=

# Reliable asynchronous event delivery. The target must be an HTTPS endpoint
# that deduplicates by (tenant_id,event_id). Use an independent service secret.
HUAMEI_OUTBOX_DELIVERY_ENABLED=false
HUAMEI_OUTBOX_TENANTS=huamei-shanghai
HUAMEI_OUTBOX_TARGET_URL=
HUAMEI_OUTBOX_TARGET_SERVICE_KEY=
HUAMEI_OUTBOX_TARGET_TIMEOUT_MS=10000
HUAMEI_OUTBOX_BATCH_SIZE=25
HUAMEI_OUTBOX_MAX_IN_FLIGHT=50
HUAMEI_OUTBOX_LEASE_MS=30000
HUAMEI_OUTBOX_POLL_INTERVAL_MS=500
HUAMEI_OUTBOX_METRICS_INTERVAL_MS=60000

# Independent acquisition-agent service and caller-to-tenant authentication.
# Use one different 32+ character random secret per caller. Add separate entries
# for WeCom/other channels and grant only the permissions each connector needs.
HUAMEI_ACQUISITION_CLIENTS_JSON={"huamei_web_gateway":{"secret":"replace_with_a_32_plus_character_random_gateway_secret","tenant_ids":["huamei-shanghai"],"permissions":["service:read","conversation:write","privacy:request","runs:read","operations:read","operations:write","contact:reveal"]},"huamei_knowledge_governance":{"secret":"replace_with_a_distinct_32_plus_character_random_governance_secret","tenant_ids":["huamei-shanghai"],"permissions":["knowledge:read","knowledge:release"]}}
# Formal capacity uses a separate caller entry with conversation:write and
# formal-load:execute. Never grant formal-load:execute or wildcard permissions
# to huamei_web_gateway. The normal stack stays disabled; use the dedicated
# docker-compose.formal-capacity.example.yml override only for the approved window.
HUAMEI_FORMAL_LOAD_TAXONOMY_ENABLED=false
HUAMEI_FORMAL_LOAD_TAXONOMY_MANIFEST_HOST_PATH=
HUAMEI_FORMAL_LOAD_TAXONOMY_MANIFEST_SHA256=
HUAMEI_FORMAL_LOAD_TAXONOMY_TRUSTED_SIGNERS_B64=
# Register a separate private privacy-console caller with only privacy:read/privacy:process.
# Never add those permissions to the public web-gateway caller or reuse its secret.
HUAMEI_ACQUISITION_CALLER_ID=huamei_web_gateway
HUAMEI_ACQUISITION_CALLER_SECRET=
HUAMEI_ACQUISITION_TENANT_ID=huamei-shanghai
HUAMEI_ACQUISITION_SERVICE_RATE_LIMIT=30000
# Independent observability credentials. These five values must be random,
# mutually different and not reused as an API, caller, database or model key.
HUAMEI_ACQUISITION_METRICS_TOKEN=
HUAMEI_OUTBOX_METRICS_TOKEN=
HUAMEI_CANARY_ACQUISITION_METRICS_TOKEN=
HUAMEI_GRAPHRAG_METRICS_TOKEN=
HUAMEI_CANARY_GRAPHRAG_METRICS_TOKEN=
# First-install governance uses no exposed host port.  The protected directory
# must be owned/readable by container uid 1000, mode 0700, with regular files
# mode 0600 and no symlinks. caller-secret must exactly match the registry entry.
HUAMEI_KNOWLEDGE_GOVERNANCE_CALLER_ID=huamei_knowledge_governance
HUAMEI_KNOWLEDGE_GOVERNANCE_TENANT_ID=huamei-shanghai
HUAMEI_KNOWLEDGE_GOVERNANCE_INPUT_HOST_PATH=
HUAMEI_CONVERSATION_RECEIPT_TIMEOUT_MS=120000
HUAMEI_CONVERSATION_SEQUENCE_WAIT_MS=10000
# 恢复worker使用运行时RLS角色，因此必须明确列出需扫描的所有租户。
HUAMEI_CONVERSATION_RECOVERY_INTERVAL_MS=5000
HUAMEI_CONVERSATION_RECOVERY_TENANT_IDS=huamei-shanghai
HUAMEI_CONVERSATION_RECOVERY_MAX_CONSECUTIVE_FAILURES=3
HUAMEI_CONVERSATION_RECOVERY_MAX_SUCCESS_AGE_MS=20000
HUAMEI_CONVERSATION_RECOVERY_METRICS_TOKEN=
HUAMEI_RELEASE_TENANT_IDS=huamei-shanghai
HUAMEI_RELEASE_PREFLIGHT_TIMEOUT_MS=5000
# Trust scope used by the endpoint registry and signed formal evidence.
# Use preproduction for the admission run; production only for a production-bound rerun.
HUAMEI_EVIDENCE_ENVIRONMENT=preproduction
# Formal release evidence must be generated in preproduction with the exact
# images, real model and active index. The directory is mounted read-only and
# must contain the two signed v2 reports, all five signed source documents and
# the immutable Prometheus raw export independently attested by SRE.
HUAMEI_RELEASE_EVIDENCE_HOST_PATH=
HUAMEI_RELEASE_EVALUATION_REPORT_SHA256=
HUAMEI_RELEASE_CAPACITY_REPORT_SHA256=
HUAMEI_FORMAL_BLIND_DATASET_SHA256=
HUAMEI_FORMAL_EVALUATION_RAW_SHA256=
HUAMEI_FORMAL_EVALUATION_SCORECARD_SHA256=
HUAMEI_FORMAL_CAPACITY_RAW_SHA256=
HUAMEI_FORMAL_CAPACITY_PROMETHEUS_SHA256=
HUAMEI_FORMAL_CAPACITY_ATTESTATION_SHA256=
# Externally controlled registry that binds tenant+environment to one exact
# public HTTPS evaluation origin and immutable deployment identity.
HUAMEI_FORMAL_EVALUATION_ENDPOINT_REGISTRY_HOST_PATH=
HUAMEI_FORMAL_EVALUATION_ENDPOINT_REGISTRY_SHA256=
# Base64-encoded JSON registry of trusted Ed25519 SPKI public keys, allowed
# evidence kinds and authority roles. Private signing keys never belong here.
HUAMEI_FORMAL_EVIDENCE_TRUSTED_SIGNERS_B64=
HUAMEI_KNOWLEDGE_APPROVAL_MODE=enforce
# Absolute host path to the reviewed Huamei v1 knowledge package (mounted read-only).
# It must include manifest.json, rag/knowledge_units.jsonl and the exact immutable
# rag/huamei-public-safe.jsonl used as both the Node public fallback package and
# official GraphRAG input. Do not regenerate or reserialize the catalog on host.
HUAMEI_KNOWLEDGE_HOST_PATH=

# Public-session credential and trusted reverse-proxy boundary.
HUAMEI_PUBLIC_SESSION_SECRET=
HUAMEI_PUBLIC_SESSION_TTL_SECONDS=1800
HUAMEI_PUBLIC_LEGACY_SESSION_COMPAT=false
HUAMEI_TRUST_PROXY=true
# Caddy and the app share a dedicated internal proxy network. Keep these two
# values in the same subnet and avoid overlap with the host/VPC address space.
HUAMEI_PROXY_SUBNET=172.31.254.0/28
HUAMEI_CADDY_PROXY_IP=172.31.254.2
# Exact immediate proxy addresses only, comma separated. The Compose example
# derives this from HUAMEI_CADDY_PROXY_IP rather than trusting a whole subnet.
HUAMEI_TRUSTED_PROXY_ADDRESSES=172.31.254.2

# Enterprise identity for administrators and three independent knowledge reviewers.
# Roles used by phase one: knowledge.release_manager,
# knowledge.business_reviewer, knowledge.medical_reviewer,
# knowledge.compliance_reviewer, knowledge.index_manager, knowledge.publisher.
HUAMEI_OIDC_REQUIRED=true
HUAMEI_ADMIN_BROWSER_AUTH_MODE=external_oidc_pkce_proxy
HUAMEI_ADMIN_IDENTITY_PROXY_SESSION_BACKEND=redis
HUAMEI_ADMIN_IDENTITY_PROXY_PRODUCT=oauth2-proxy
HUAMEI_ADMIN_IDENTITY_PROXY_HEALTH_URL=
HUAMEI_ADMIN_IDENTITY_PROXY_UPSTREAM_AUTHORIZATION_MODE=overwrite_verified_bearer
HUAMEI_ADMIN_IDENTITY_PROXY_SECURITY_PROFILE=state_nonce_pkce_origin_logout
HUAMEI_ADMIN_IDENTITY_PROXY_HA_REPLICAS=2
HUAMEI_ADMIN_ORIGIN=
HUAMEI_OIDC_ISSUER=
HUAMEI_OIDC_AUDIENCE=huamei-acquisition
HUAMEI_OIDC_JWKS_URL=
HUAMEI_OIDC_ROLE_CLAIM=roles
HUAMEI_OIDC_TENANT_CLAIM=tenant_ids
HUAMEI_OIDC_CLOCK_SKEW_SECONDS=60
# Privacy workflow roles: privacy.processor and privacy.approver.
HUAMEI_PRIVACY_REQUEST_SLA_HOURS=360

# Controlled evidence-runner only. Mount each Ed25519 private key read-only from
# the CI/KMS secret boundary; never copy these values into long-running services.
# Generic signer handles blind_dataset, evaluation_scorecard, capacity_raw and
# capacity_observability_attestation inputs.
HUAMEI_FORMAL_EVIDENCE_SIGNER_ID=
HUAMEI_FORMAL_EVIDENCE_SIGNING_KEY_PATH=
HUAMEI_FORMAL_EVALUATION_RAW_SIGNER_ID=
HUAMEI_FORMAL_EVALUATION_RAW_SIGNING_KEY_PATH=
HUAMEI_FORMAL_EVALUATION_REPORT_SIGNER_ID=
HUAMEI_FORMAL_EVALUATION_REPORT_SIGNING_KEY_PATH=
HUAMEI_FORMAL_CAPACITY_REPORT_SIGNER_ID=
HUAMEI_FORMAL_CAPACITY_REPORT_SIGNING_KEY_PATH=

# Private GraphRAG retrieval tier. Production accepts only an immutable official
# Microsoft GraphRAG artifact that is bound to the approved knowledge release.
HUAMEI_GRAPHRAG_SERVICE_KEY=
HUAMEI_GRAPHRAG_ENGINE=official
HUAMEI_GRAPHRAG_INDEX_VERSION=
HUAMEI_GRAPHRAG_READINESS_RECORD_ID=
HUAMEI_RELEASE_GRAPHRAG_MANIFEST_SHA256=
# Force LiteLLM to use its packaged cost map; model API egress remains explicit
# through GRAPHRAG_API_BASE and the server/network allowlist.
LITELLM_LOCAL_MODEL_COST_MAP=True
# Absolute host path containing manifest.json and the official parquet/vector artifacts.
HUAMEI_GRAPHRAG_OFFICIAL_OUTPUT_HOST_PATH=

# Used by the official GraphRAG runtime and offline index build. The API key must
# be stored in the deployment secret manager, never in an image or source control.
GRAPHRAG_MODEL_PROVIDER=
GRAPHRAG_API_BASE=
GRAPHRAG_API_KEY=
GRAPHRAG_COMPLETION_MODEL=
GRAPHRAG_EMBEDDING_MODEL=

# OpenAI-compatible language model. Rules-only mode is development/demo only and
# cannot pass production release preflight. Inject the key with the secret manager.
HUAMEI_LLM_ENABLED=true
HUAMEI_LLM_PROVIDER=openai_compatible
HUAMEI_LLM_BASE_URL=
HUAMEI_LLM_API_KEY=
HUAMEI_LLM_MODEL=
HUAMEI_LLM_TIMEOUT_MS=20000
HUAMEI_LLM_MAX_RETRIES=1
# Set true only after the privacy/security owner approves the model data flow.
HUAMEI_LLM_DATA_EGRESS_APPROVED=false
# Controlled approval reference plus exact host[:port] entries from
# HUAMEI_LLM_BASE_URL and GRAPHRAG_API_BASE.
HUAMEI_LLM_DATA_EGRESS_APPROVAL_ID=
HUAMEI_APPROVED_MODEL_EGRESS_HOSTS=
# Only an approved private-network HTTP model gateway may set this true. Public
# model endpoints must use HTTPS regardless of this flag.
HUAMEI_LLM_INTERNAL_ENDPOINT_APPROVED=false

# MiniMax video generation is intentionally disabled by default.
MINIMAX_REAL_CALL_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_REAL_USER_IDS=
MINIMAX_DAILY_REAL_JOB_LIMIT=5
MINIMAX_POLL_INTERVAL_MS=10000
MINIMAX_MAX_POLL_ERRORS=8
MINIMAX_TIMEOUT_MS=60000
MINIMAX_CALLBACK_PUBLIC_URL=
MINIMAX_CALLBACK_TOKEN=

# Customer-confirmed arrival registration uses PostgreSQL in production.
# Optional maintained workday calendar JSON. Missing/expired calendar => customer picks date.
HUAMEI_WORKDAY_CALENDAR_FILE=
# Local development only; never select JSON persistence in production.
# HUAMEI_APPOINTMENT_REGISTRATION_FILE=.local-data/appointment-registrations.json
