# Copy to deploy/local/.env. These values are local-only placeholders and must
# never be reused in a shared, staging, or production environment.
HUAMEI_POSTGRES_DB=huamei
HUAMEI_POSTGRES_USER=huamei_app
HUAMEI_POSTGRES_PASSWORD=replace_with_local_only_postgres_password
HUAMEI_POSTGRES_PORT=5432

HUAMEI_REDIS_PASSWORD=replace_with_local_only_redis_password
HUAMEI_REDIS_PORT=6379

# Optional Adminer profile: docker compose --profile tools up -d
HUAMEI_ADMINER_PORT=8080

# Application-side URLs when the Node services run directly on the host.
HUAMEI_PERSISTENCE_BACKEND=postgres
HUAMEI_CACHE_BACKEND=redis
HUAMEI_DATABASE_URL=postgresql://huamei_app:replace_with_local_only_postgres_password@127.0.0.1:5432/huamei
HUAMEI_REDIS_URL=redis://:replace_with_local_only_redis_password@127.0.0.1:6379/0

# Required when exercising PostgreSQL lead capture/contact reveal locally.
# Generate an independent value; never reuse the general field-encryption key.
HUAMEI_CONTACT_VAULT_KEYRING_JSON={"active_key_id":"local-contact-v1","keys":{"local-contact-v1":"replace_with_openssl_rand_base64_32"}}
