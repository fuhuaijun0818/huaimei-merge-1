# Copy to deploy/external-test/.env only on the target host, then chmod 600.
# This deployment is an authenticated, single-host external-test environment;
# it must not be labelled or used as the high-availability production release.
HUAMEI_BUILD_REVISION=external-test
HUAMEI_BUILD_CREATED=
HUAMEI_EXTERNAL_HTTP_BIND_ADDRESS=127.0.0.1
HUAMEI_EXTERNAL_HTTP_PORT=4173
# Public access uses compose.tls.yml. Keep the resolved image digest pinned.
HUAMEI_EXTERNAL_DOMAIN=
HUAMEI_EXTERNAL_CADDY_IMAGE=
HUAMEI_EXTERNAL_PROXY_IP=172.30.86.10
HUAMEI_EXTERNAL_PROXY_SUBNET=172.30.86.0/24
# 仅供 Docker Hub 不可达的外测主机使用；正式环境必须固定经批准的镜像摘要。
HUAMEI_NODE_IMAGE=docker.m.daocloud.io/library/node:22.22.1-bookworm-slim

# Independent random secrets; actual values never belong in the repository.
HUAMEI_API_KEY=
HUAMEI_ACQUISITION_SERVICE_KEY=
# Same on web and acquisition; separate from the API/service keys and passwords.
HUAMEI_EXTERNAL_TEST_ADMIN_BRIDGE_SECRET=
HUAMEI_ADMIN_USERNAME=admin
HUAMEI_ADMIN_PASSWORD=
HUAMEI_PREVIEW_USERNAME=preview
HUAMEI_PREVIEW_PASSWORD=

# Comma-separated exact browser origins, no trailing slash and no wildcard.
# Example: http://203.0.113.10,http://preview.example.com
HUAMEI_ALLOWED_ORIGINS=

# Approved Qwen-compatible model configuration. Keep the actual key only here.
HUAMEI_LLM_ENABLED=true
HUAMEI_LLM_PROVIDER=aliyun_model_studio
HUAMEI_LLM_BASE_URL=
HUAMEI_LLM_API_KEY=
HUAMEI_LLM_MODEL=qwen3.7-flash
HUAMEI_LLM_TIMEOUT_MS=20000
HUAMEI_LLM_MAX_RETRIES=1
