HUAMEI_RUNTIME_ENV=production
HUAMEI_LOG_LEVEL=info
HUAMEI_OBSERVABILITY_HOST=0.0.0.0
HUAMEI_OBSERVABILITY_PORT=9190
# Use separate secret-manager files. Each token is 32+ random characters and
# must not be reused by any API or service caller.
HUAMEI_ACQUISITION_METRICS_TOKEN_FILE=/run/secrets/huamei_acquisition_metrics_token
HUAMEI_OUTBOX_METRICS_TOKEN_FILE=/run/secrets/huamei_outbox_metrics_token
HUAMEI_GRAPHRAG_METRICS_TOKEN_FILE=/run/secrets/huamei_graphrag_metrics_token
