HUAMEI_LLM_ENABLED=false
HUAMEI_LLM_PROVIDER=aliyun_model_studio
HUAMEI_LLM_BASE_URL=https://example.com/compatible-mode/v1
HUAMEI_LLM_API_KEY=replace_with_your_secret
HUAMEI_LLM_MODEL=qwen3.7-flash
HUAMEI_LLM_TIMEOUT_MS=20000
HUAMEI_LLM_MAX_RETRIES=1
# 正式环境必须完成数据出境/内部模型流量审批后才设为true。
HUAMEI_LLM_DATA_EGRESS_APPROVED=false
# 仅已审批的私网HTTP模型端点需要此开关；外网端点始终必须HTTPS。
HUAMEI_LLM_INTERNAL_ENDPOINT_APPROVED=false

# 生产持久化与共享协调层。本地可配合 deploy/local/compose.yml 使用。
# 正式环境必须使用 postgres/redis，不能继续使用 :memory: 或本地 JSON 文件。
HUAMEI_PERSISTENCE_BACKEND=local_json
HUAMEI_CACHE_BACKEND=memory
HUAMEI_DATABASE_URL=
HUAMEI_POSTGRES_POOL_MAX=20
HUAMEI_POSTGRES_IDLE_TIMEOUT_MS=30000
HUAMEI_POSTGRES_CONNECT_TIMEOUT_MS=5000
HUAMEI_POSTGRES_STATEMENT_TIMEOUT_MS=15000
HUAMEI_POSTGRES_QUERY_TIMEOUT_MS=20000
HUAMEI_POSTGRES_LOCK_TIMEOUT_MS=3000
HUAMEI_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
HUAMEI_REDIS_URL=
HUAMEI_REDIS_CONNECT_TIMEOUT_MS=5000
HUAMEI_REDIS_COMMAND_TIMEOUT_MS=3000

# 应用层敏感字段加密。开发环境可留空；生产必须由Secret Manager注入。
# 全新v2库格式：{"active_key_id":"phase1-v2","keys":{"phase1-v2":"<openssl rand -base64 32>"}}
# v1→v2受控切换期临时保留新旧两个独立key，见docs/operations/FIELD_ENCRYPTION.md。
# 旧密钥在完成重加密前必须保留在keys中；不得将真实密钥写入仓库或日志。
HUAMEI_FIELD_ENCRYPTION_KEYRING_JSON=
# 可逆联系方式保险库使用独立AES-256-GCM密钥域，不得与上述通用字段密钥复用。
# 使用相同版本化JSON格式；PostgreSQL留资必须配置，本地纯内存模式可留空。
HUAMEI_CONTACT_VAULT_KEYRING_JSON=

# 事务外发事件worker；只有接入支持event_id幂等的HTTPS事件接收端后再启用。
HUAMEI_OUTBOX_TENANTS=huamei-shanghai
HUAMEI_OUTBOX_DELIVERY_ENABLED=false
HUAMEI_OUTBOX_TARGET_URL=
HUAMEI_OUTBOX_TARGET_SERVICE_KEY=
HUAMEI_OUTBOX_TARGET_TIMEOUT_MS=10000
HUAMEI_OUTBOX_BATCH_SIZE=25
HUAMEI_OUTBOX_MAX_IN_FLIGHT=50
HUAMEI_OUTBOX_LEASE_MS=30000
HUAMEI_OUTBOX_POLL_INTERVAL_MS=500
HUAMEI_OUTBOX_METRICS_INTERVAL_MS=60000

# 华美售前知识包与多轮会话（正式环境建议只读挂载）
HUAMEI_KNOWLEDGE_ROOT=../一期项目文件/华美智能体知识库_v1
# 已审核公开资料解析与阿里云OSS分发。上传脚本默认仅演练，必须带 --apply 才会上传。
HUAMEI_PUBLIC_MATERIALS_ROOT=../一期项目文件/原始数据/公开资料
HUAMEI_PUBLIC_MATERIALS_PACKAGE_ROOT=../一期项目文件/华美智能体知识库_v1/public-materials-v1
HUAMEI_PUBLIC_MATERIALS_OCR_WORKERS=4
HUAMEI_OSS_ENDPOINT=
HUAMEI_OSS_REGION=
HUAMEI_OSS_BUCKET=
HUAMEI_OSS_ACCESS_KEY_ID=
HUAMEI_OSS_ACCESS_KEY_SECRET=
HUAMEI_OSS_PUBLIC_BASE_URL=
HUAMEI_OSS_PREFIX=huamei/public-materials/v1
HUAMEI_OSS_TIMEOUT_MS=60000
HUAMEI_ACQUISITION_SESSION_TTL_MS=1800000
HUAMEI_ACQUISITION_MAX_SESSIONS=2000
# 入站收件超过该时间未完成时转为可重放失败；后续序号不会被静默跳过。
HUAMEI_CONVERSATION_RECEIPT_TIMEOUT_MS=120000
HUAMEI_CONVERSATION_SEQUENCE_WAIT_MS=10000
HUAMEI_CONVERSATION_RECOVERY_INTERVAL_MS=5000
HUAMEI_CONVERSATION_RECOVERY_TENANT_IDS=huamei-shanghai
HUAMEI_CONVERSATION_RECOVERY_MAX_CONSECUTIVE_FAILURES=3
HUAMEI_CONVERSATION_RECOVERY_MAX_SUCCESS_AGE_MS=20000
HUAMEI_CONVERSATION_RECOVERY_METRICS_TOKEN=
HUAMEI_DEFAULT_TENANT_ID=huamei-shanghai
HUAMEI_PUBLIC_TENANT_ID=huamei-shanghai
# 本地联调默认preview；正式试点必须改为enforce并通过三审发布接口激活知识版本。
HUAMEI_KNOWLEDGE_APPROVAL_MODE=preview
HUAMEI_ACQUISITION_SESSION_STORE_FILE=.local-data/acquisition-sessions.json
HUAMEI_ACQUISITION_OPERATIONS_STORE_FILE=.local-data/acquisition-operations.json
HUAMEI_KNOWLEDGE_RELEASE_STORE_FILE=.local-data/knowledge-releases.json

# 售前智能体独立服务。默认仅监听本机4180，由网页网关通过HTTP调用。
HUAMEI_ACQUISITION_SERVICE_HOST=127.0.0.1
HUAMEI_ACQUISITION_SERVICE_PORT=4180
HUAMEI_ACQUISITION_SERVICE_URL=http://127.0.0.1:4180
HUAMEI_ACQUISITION_SERVICE_TIMEOUT_MS=30000
HUAMEI_ACQUISITION_SERVICE_RATE_LIMIT=1200
# 本机无注册表时仅保留开发兼容。生产必须使用调用方注册表，把caller绑定到租户和最小权限。
HUAMEI_ACQUISITION_CLIENTS_JSON=
# Production privacy operations require a separate private caller limited to privacy:read/privacy:process.
HUAMEI_ACQUISITION_CALLER_ID=huamei_web_gateway
HUAMEI_ACQUISITION_CALLER_SECRET=
HUAMEI_ACQUISITION_TENANT_ID=huamei-shanghai
# 旧版共享密钥仅供本地兼容，生产不使用。
HUAMEI_ACQUISITION_SERVICE_KEY=

# LangGraph/LangChain 编排服务 P0-A：默认不参与对客回复；对客唯一权威仍为 legacy。
# 仅在本机契约或经批准的 Shadow 环境启动服务。服务与线程密钥必须独立，且不得复用模型、GraphRAG、网关或数据库密码。
HUAMEI_AGENT_ENGINE=legacy
HUAMEI_LANGGRAPH_HOST=127.0.0.1
HUAMEI_LANGGRAPH_PORT=4192
HUAMEI_LANGGRAPH_ORCHESTRATOR_URL=http://127.0.0.1:4192
HUAMEI_LANGGRAPH_SERVICE_AUTH_SECRET=
HUAMEI_LANGGRAPH_THREAD_SECRET=
HUAMEI_LANGGRAPH_AUDIENCE=huamei-agent-orchestrator
HUAMEI_LANGGRAPH_TIMEOUT_MS=4000
HUAMEI_LANGGRAPH_GRAPH_VERSION=v1
HUAMEI_LANGGRAPH_STATE_SCHEMA_VERSION=v1
# 仅在数据出域/脱敏/评测审批完成后的 Shadow 观察窗口设为 true；不会对客户投递回复。
HUAMEI_LANGGRAPH_SHADOW_ADMITTED=false
HUAMEI_LANGGRAPH_ENABLE_DURABLE_CHECKPOINTS=false
HUAMEI_LANGGRAPH_CHECKPOINT_DATABASE_URL=
HUAMEI_LANGGRAPH_MAX_CONCURRENCY=20

# 公共会话签名和可信反向代理。生产会话密钥应使用独立的32字节以上随机值。
HUAMEI_PUBLIC_SESSION_SECRET=
HUAMEI_PUBLIC_SESSION_TTL_SECONDS=1800
HUAMEI_PUBLIC_LEGACY_SESSION_COMPAT=true
# 网页留资只校验11位中国大陆手机号格式；保存后状态为待人工核号。

# 院方确认 scrm 查询接口无需验签，使用 none；返回值仅表示是否已有客户记录。
# akey 仅放服务端私有环境；none 不需要 secret、token 或固定签名。
HUAMEI_MEMBER_CHECK_ENABLED=false
HUAMEI_MEMBER_CHECK_AUTH_MODE=none
HUAMEI_MEMBER_CHECK_URL=
HUAMEI_MEMBER_CHECK_HTTP_METHOD=
HUAMEI_MEMBER_CHECK_TENANT_ID=
HUAMEI_MEMBER_CHECK_AKEY=
HUAMEI_MEMBER_CHECK_SECRET=
HUAMEI_MEMBER_CHECK_TOKEN=
# 以下固定签名字段仅供旧版 development 兼容模式，none 不使用。
HUAMEI_MEMBER_CHECK_PROVIDED_TIMESTAMP=
HUAMEI_MEMBER_CHECK_PROVIDED_NONCE=
HUAMEI_MEMBER_CHECK_PROVIDED_SIGN=
HUAMEI_MEMBER_CHECK_OPERATION=
HUAMEI_MEMBER_CHECK_RESULT_SEMANTICS=duplicate_only
HUAMEI_MEMBER_CHECK_HOSPITAL=
HUAMEI_MEMBER_CHECK_HOSPITAL_CODE=
HUAMEI_MEMBER_CHECK_TIMEOUT_MS=2000
HUAMEI_MEMBER_CHECK_CACHE_MS=60000
# 数据主体权利请求：可信身份核验适配器和执行/交付适配器必须使用两个独立强密钥签发短期attestation。
HUAMEI_PRIVACY_VERIFICATION_SECRET=
HUAMEI_PRIVACY_COMPLETION_SECRET=
HUAMEI_PRIVACY_CANCELLATION_SECRET=
HUAMEI_TRUST_PROXY=false
HUAMEI_TRUSTED_PROXY_ADDRESSES=

# 企业身份与知识三审。开发环境可留空；正式环境必须接OIDC。
HUAMEI_OIDC_REQUIRED=false
HUAMEI_OIDC_ISSUER=
HUAMEI_OIDC_AUDIENCE=huamei-acquisition
HUAMEI_OIDC_JWKS_URL=
HUAMEI_OIDC_ROLE_CLAIM=roles
HUAMEI_OIDC_TENANT_CLAIM=tenant_ids
HUAMEI_PRIVACY_REQUEST_SLA_HOURS=360

# GraphRAG独立检索服务；本地启动器在隔离环境存在时自动启动。
HUAMEI_GRAPHRAG_ENABLED=true
HUAMEI_FORMAL_LOAD_TAXONOMY_ENABLED=false
HUAMEI_GRAPHRAG_HOST=127.0.0.1
HUAMEI_GRAPHRAG_PORT=4191
HUAMEI_GRAPHRAG_URL=http://127.0.0.1:4191
HUAMEI_GRAPHRAG_ENGINE=auto
HUAMEI_GRAPHRAG_WORKERS=4
HUAMEI_GRAPHRAG_MAX_CONCURRENCY=128
HUAMEI_GRAPHRAG_TIMEOUT_MS=1500
HUAMEI_GRAPHRAG_TOP_K=6
# Per-intent evidence-only tuning output; unset uses top_k=6/entities=10/relationships=10.
# HUAMEI_GRAPHRAG_TUNING_JSON={"default":{"top_k":6,"top_k_entities":10,"top_k_relationships":10}}
HUAMEI_GRAPHRAG_SERVICE_KEY=
HUAMEI_GRAPHRAG_METRICS_TOKEN=
HUAMEI_GRAPHRAG_READINESS_RECORD_ID=
LITELLM_LOCAL_MODEL_COST_MAP=True

# MiniMax H3 V2 医师AI分身（仅服务端读取，禁止放入前端代码）
# 聊天、截图或调试日志中出现过的密钥必须先轮换，再填写到.env.local。
MINIMAX_API_KEY=replace_with_rotated_minimax_key
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_REAL_CALL_ENABLED=false
MINIMAX_REAL_USER_IDS=admin-xuning
MINIMAX_DAILY_REAL_JOB_LIMIT=5
MINIMAX_POLL_INTERVAL_MS=10000
MINIMAX_MAX_POLL_ERRORS=8
MINIMAX_CALLBACK_TOKEN=replace_with_random_callback_token
MINIMAX_CALLBACK_PUBLIC_URL=

# Customer-confirmed arrival registration uses PostgreSQL in production.
# Optional maintained workday calendar JSON. Missing/expired calendar => customer picks date.
HUAMEI_WORKDAY_CALENDAR_FILE=
# Local development only; never select JSON persistence in production.
# HUAMEI_APPOINTMENT_REGISTRATION_FILE=.local-data/appointment-registrations.json

# Local browser login: uses existing HUAMEI_ADMIN_USERNAME/PASSWORD.
# Server sessions expire after 30 minutes idle / 8 hours total; restart requires login.
# Enable on loopback with HUAMEI_LOCAL_REQUIRE_AUTH=true. External HTTPS opt-in:
# HUAMEI_ADMIN_SESSION_AUTH=true (requires explicit HUAMEI_ALLOWED_ORIGINS).

# Optional bounded semantic clarification; only redacted current text and last four turns.
HUAMEI_SEMANTIC_UNDERSTANDING_ENABLED=false

# Context-aware paraphrasing with an independent evidence and safety review.
HUAMEI_NATURAL_DIALOGUE_ENABLED=false

# Every normal acquisition turn uses one validated model plan before dispatch.
# Set false to roll back to deterministic routing; no API key is exposed.
HUAMEI_UNIFIED_TURN_PLANNING_ENABLED=true
